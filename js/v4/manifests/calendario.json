{
 "plugin": "calendario",
 "views": [
  {
   "id": "dia",
   "label": "dia"
  },
  {
   "id": "mês",
   "label": "mês"
  },
  {
   "id": "próximos",
   "label": "próximos"
  },
  {
   "id": "datas",
   "label": "datas",
   "list": "dates"
  }
 ],
 "lists": {
  "events": {
   "store": "events",
   "view": "dia",
   "row": {
    "text": "${title}"
   },
   "enter": {
    "op": "fn",
    "name": "evOpen"
   },
   "actions": [
    {
     "key": "e",
     "label": "editar",
     "op": {
      "op": "form",
      "form": "event",
      "label": "evento"
     }
    },
    {
     "key": "j",
     "label": "entrar na reunião",
     "when": "meet",
     "op": {
      "op": "toast",
      "text": "abrindo ${meet}"
     }
    },
    {
     "key": "x",
     "label": "excluir",
     "op": {
      "op": "remove",
      "confirm": "excluir ${title} da agenda?"
     }
    }
   ]
  },
  "dates": {
   "store": "dates",
   "view": "datas",
   "row": {
    "g": "${kind?◆:·}",
    "text": "${day}  ${name}",
    "meta": "${kind}${reminder? · lembrete :}${reminder}"
   },
   "actions": [
    {
     "key": "e",
     "label": "editar",
     "op": {
      "op": "form",
      "form": "date",
      "label": "data especial"
     }
    },
    {
     "key": "x",
     "label": "excluir",
     "op": {
      "op": "remove",
      "toast": "data excluída"
     }
    }
   ],
   "enter": {
    "op": "form",
    "form": "date",
    "label": "data especial"
   }
  }
 },
 "forms": {
  "event": [
   {
    "field": "title",
    "label": "título",
    "type": "text"
   },
   {
    "field": "date",
    "label": "data",
    "type": "text"
   },
   {
    "field": "time",
    "label": "hora",
    "type": "text"
   },
   {
    "field": "dur",
    "label": "duração",
    "type": "text"
   },
   {
    "field": "allDay",
    "label": "dia inteiro",
    "type": "bool"
   },
   {
    "field": "place",
    "label": "local",
    "type": "text"
   },
   {
    "field": "meet",
    "label": "link do Meet",
    "type": "text"
   },
   {
    "field": "people",
    "label": "participantes",
    "type": "list"
   },
   {
    "field": "reminder",
    "label": "lembrete",
    "type": "choice",
    "values": [
     "nenhum",
     "10 min",
     "1 h",
     "1 dia"
    ]
   },
   {
    "field": "present",
    "label": "presentes",
    "type": "display",
    "value": "${present} confirmados"
   },
   {
    "field": "desc",
    "label": "descrição",
    "type": "long"
   }
  ],
  "date": [
   {
    "field": "name",
    "label": "nome",
    "type": "text"
   },
   {
    "field": "day",
    "label": "dia",
    "type": "text"
   },
   {
    "field": "kind",
    "label": "tipo",
    "type": "choice",
    "values": [
     "aniversário",
     "feriado",
     "especial"
    ]
   },
   {
    "field": "reminder",
    "label": "lembrete",
    "type": "choice",
    "values": [
     "nenhum",
     "no dia",
     "1 dia antes",
     "1 semana antes"
    ]
   }
  ]
 },
 "commands": [
  {
   "name": "new",
   "desc": "novo evento",
   "op": {
    "op": "new",
    "list": "events",
    "item": {
     "title": "${$args}",
     "date": "${data.day}",
     "time": "09:00",
     "dur": "30",
     "kind": "meet",
     "people": [],
     "present": 0
    },
    "form": "event",
    "label": "evento"
   }
  },
  {
   "name": "today",
   "desc": "voltar para hoje",
   "op": {
    "op": "seq",
    "ops": [
     {
      "op": "set",
      "path": "data.day",
      "value": 17
     },
     {
      "op": "view",
      "view": "dia"
     }
    ]
   }
  },
  {
   "name": "connect",
   "desc": "google · microsoft",
   "op": {
    "op": "fn",
    "name": "connect"
   }
  },
  {
   "name": "disconnect",
   "desc": "voltar à agenda local",
   "op": {
    "op": "seq",
    "ops": [
     {
      "op": "set",
      "path": "store.calendarProvider",
      "value": "local"
     },
     {
      "op": "toast",
      "text": "agenda local · Google desconectado"
     }
    ]
   }
  },
  {
   "name": "import-holidays",
   "desc": "feriados do país",
   "op": {
    "op": "async",
    "label": "importando feriados ${$args}",
    "then": {
     "op": "seq",
     "ops": [
      {
       "op": "push",
       "path": "store.dates",
       "value": {
        "day": "2 nov",
        "name": "Finados",
        "kind": "feriado"
       }
      },
      {
       "op": "push",
       "path": "store.dates",
       "value": {
        "day": "15 nov",
        "name": "Proclamação da República",
        "kind": "feriado"
       }
      },
      {
       "op": "toast",
       "text": "2 feriados importados"
      }
     ]
    }
   }
  },
  {
   "name": "new-date",
   "desc": "aniversário ou data especial",
   "op": {
    "op": "new",
    "list": "dates",
    "item": {
     "name": "${$args}",
     "day": "30 out",
     "kind": "aniversário",
     "reminder": "1 dia antes"
    },
    "form": "date",
    "label": "data especial",
    "back": "datas"
   }
  }
 ],
