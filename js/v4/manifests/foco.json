{
 "plugin": "foco",
 "views": [
  {
   "id": "timer",
   "label": "timer"
  },
  {
   "id": "tarefas",
   "label": "tarefas",
   "list": "tasks",
   "sub": [
    {
     "label": "ativas",
     "where": "!done"
    },
    {
     "label": "concluídas",
     "where": "done"
    }
   ]
  },
  {
   "id": "histórico",
   "label": "histórico"
  },
  {
   "id": "notas",
   "label": "notas",
   "list": "notes",
   "sub": [
    {
     "label": "ativas",
     "where": "!done"
    },
    {
     "label": "concluídas",
     "where": "done"
    }
   ]
  },
  {
   "id": "ajustes",
   "label": "ajustes"
  }
 ],
 "lists": {
  "tasks": {
   "store": "tasks",
   "view": "tarefas",
   "row": {
    "g": "${done?●:○}",
    "text": "${text}",
    "meta": "${focus?em foco:}",
    "tone": "${done?dim:}"
   },
   "actions": [
    {
     "key": "f",
     "label": "focar nesta tarefa",
     "op": {
      "op": "set",
      "path": "item.focus",
      "value": true,
      "exclusive": true,
      "toast": "em foco: ${text}"
     }
    },
    {
     "key": "c",
     "label": "concluir ou reabrir",
     "op": {
      "op": "toggle",
      "path": "item.done",
      "toast": "${text} ${done?concluída:reaberta}"
     }
    },
    {
     "key": "e",
     "label": "editar",
     "op": {
      "op": "edit",
      "field": "text",
      "label": "tarefa"
     }
    },
    {
     "key": "x",
     "label": "excluir",
     "op": {
      "op": "remove",
      "toast": "tarefa excluída"
     }
    }
   ],
   "enter": {
    "op": "set",
    "path": "item.focus",
    "value": true,
    "exclusive": true,
    "toast": "em foco: ${text}"
   }
  }
 },
 "itemActions": {
  "timer": [
   {
    "key": "r",
    "label": "zerar",
    "op": {
     "op": "fn",
     "name": "focusReset"
    }
   },
   {
    "key": "p",
    "label": "pular fase",
    "op": {
     "op": "fn",
     "name": "focusSkip"
    }
   }
  ]
 },
 "commands": [
  {
   "name": "reset",
   "desc": "zerar o timer",
   "op": {
    "op": "fn",
    "name": "focusReset"
   }
  },
  {
   "name": "skip",
   "desc": "pular a fase",
   "op": {
    "op": "fn",
    "name": "focusSkip"
   }
  }
 ],
 "seed": {
