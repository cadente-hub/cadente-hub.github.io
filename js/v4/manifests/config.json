{
 "plugin": "config",
 "views": [
  {
   "id": "geral",
   "label": "geral",
   "list": "settings",
   "group": "sec"
  },
  {
   "id": "chat",
   "label": "chat",
   "list": "settings",
   "where": {
    "sec": "chat"
   }
  },
  {
   "id": "aparência",
   "label": "aparência",
   "list": "settings",
   "where": {
    "sec": "aparência"
   }
  },
  {
   "id": "git",
   "label": "git",
   "list": "settings",
   "where": {
    "sec": "git"
   }
  },
  {
   "id": "contas",
   "label": "contas",
   "blocks": [
    {
     "list": "accounts",
     "label": "contas"
    },
    {
     "list": "settings",
     "label": "opções",
     "where": {
      "sec": "contas"
     }
    }
   ]
  },
  {
   "id": "integrações",
   "label": "integrações",
   "list": "integrations"
  },
  {
   "id": "ferramentas",
   "label": "ferramentas",
   "blocks": [
    {
     "list": "settings",
     "label": "política",
     "where": {
      "sec": "ferramentas"
     }
    },
    {
     "list": "tools",
     "label": "ferramentas"
    },
    {
     "list": "bashPatterns",
     "label": "padrões bash"
    },
    {
     "list": "approvals",
     "label": "aprovações pendentes"
    }
   ]
  },
  {
   "id": "acesso",
   "label": "acesso",
   "blocks": [
    {
     "list": "settings",
     "label": "modo",
     "where": {
      "sec": "acesso"
     }
    },
    {
     "list": "roots",
     "label": "raízes"
    }
   ]
  },
  {
   "id": "avançado",
   "label": "avançado",
   "blocks": [
    {
     "list": "envVars",
     "label": "variáveis de ambiente"
    },
    {
     "list": "settings",
     "label": "timeouts",
     "where": {
      "sec": "avançado"
     }
    }
   ]
  },
  {
   "id": "perfil",
   "label": "perfil",
   "blocks": [
    {
     "list": "profiles",
     "label": "perfis"
    },
    {
     "list": "settings",
     "label": "sessão",
     "where": {
      "sec": "perfil"
     }
    }
   ]
  },
  {
   "id": "atualizações",
   "label": "atualizações",
   "blocks": [
    {
     "list": "settings",
     "label": "preferências",
     "where": {
      "sec": "atualizações"
     }
    },
    {
     "list": "versions",
     "label": "versões"
    }
   ]
  },
  {
   "id": "atalhos",
   "label": "atalhos",
   "filter": true
  },
  {
   "id": "experimentais",
   "label": "experimentais",
   "list": "settings",
   "where": {
    "sec": "experimentais"
   }
  }
 ],
 "lists": {
  "settings": {
   "store": "settings",
   "view": "geral",
   "row": {
    "g": "${ro?◦:·}",
    "text": "${key}",
    "meta": "${value}"
   },
   "enter": {
    "op": "fn",
    "name": "cfgSetting",
    "edit": true
   },
   "space": {
    "op": "fn",
    "name": "cfgSetting"
   }
  },
  "accounts": {
   "store": "accounts",
   "view": "contas",
   "row": {
    "g": "${active?●:○}",
    "text": "${name}",
    "meta": "${provider} · ${model} · ${status}${disabled? · desabilitada:}",
    "tone": "${disabled?dim:}"
   },
   "enter": {
    "op": "form",
    "form": "account",
    "label": "conta"
   },
   "actions": [
    {
     "key": "v",
     "label": "revalidar",
     "op": {
      "op": "async",
      "label": "validando ${name}",
      "then": {
       "op": "set",
       "path": "item.status",
       "value": "válida",
       "toast": "${name} válida"
      }
     }
    },
    {
     "key": "a",
     "label": "tornar ativa",
     "op": {
      "op": "set",
      "path": "item.active",
      "value": true,
      "exclusive": true,
      "toast": "${name} é a conta ativa"
     }
    },
    {
     "key": "r",
     "label": "renomear",
     "op": {
      "op": "edit",
      "field": "name",
      "label": "nome da conta"
     }
    },
    {
     "key": "d",
     "label": "desabilitar ou habilitar",
     "op": {
      "op": "toggle",
      "path": "item.disabled",
      "toast": "${name} ${disabled?desabilitada:habilitada}"
     }
    },
    {
     "key": "e",
     "label": "editar",
     "op": {
      "op": "form",
      "form": "account",
      "label": "conta"
     }
    },
    {
     "key": "x",
     "label": "excluir",
     "op": {
      "op": "remove",
      "confirm": "excluir a conta ${name}?"
     }
    }
   ]
  },
  "integrations": {
   "store": "integrations",
   "view": "integrações",
   "row": {
    "g": "${ok?●:○}",
    "text": "${name}",
    "meta": "${status}",
    "tone": "${ok?:warn}"
   },
   "enter": {
    "op": "log",
    "cmd": "${name}",
    "out": [
     "${detail}"
    ]
   },
   "actions": [
    {
     "key": "l",
     "label": "entrar",
     "op": {
      "op": "seq",
      "ops": [
       {
        "op": "set",
        "path": "item.status",
        "value": "conectado"
       },
       {
        "op": "set",
        "path": "item.ok",
        "value": true,
        "toast": "${name} conectado"
       }
      ]
     }
    },
    {
     "key": "f",
     "label": "ver permissões e falhas",
     "op": {
      "op": "log",
      "cmd": "${name} · falhas",
      "out": [
       "${detail}"
      ]
     }
    },
    {
     "key": "m",
     "label": "MCPs",
     "op": {
      "op": "goto",
      "plugin": "recursos"
     }
    },
    {
     "key": "c",
     "label": "configurar",
     "op": {
      "op": "form",
      "form": "integration",
      "label": "integração"
     }
    }
   ]
  },
  "tools": {
   "store": "tools",
   "view": "ferramentas",
   "row": {
    "g": "·",
    "text": "${name}",
    "meta": "${policy}${override? · override:}"
   },
   "space": {
    "op": "seq",
    "ops": [
     {
      "op": "cycle",
      "path": "item.policy",
      "values": [
       "perguntar",
       "permitir",
       "negar"
      ]
     },
     {
      "op": "set",
      "path": "item.override",
      "value": true,
      "toast": "${name}: ${policy} · override"
     }
    ]
   },
   "actions": [
    {
     "key": "x",
     "label": "remover override",
     "when": "override",
     "op": {
      "op": "seq",
      "ops": [
       {
        "op": "set",
        "path": "item.policy",
        "value": "perguntar"
       },
       {
        "op": "set",
        "path": "item.override",
        "value": false,
        "toast": "override de ${name} removido"
       }
      ]
     }
    }
   ]
  },
  "bashPatterns": {
   "store": "bashPatterns",
   "view": "ferramentas",
   "row": {
    "g": "$",
    "text": "${pattern}",
    "meta": "permitido"
   },
   "actions": [
    {
     "key": "x",
     "label": "remover",
     "op": {
      "op": "remove",
      "toast": "padrão removido"
     }
    }
   ]
  },
  "approvals": {
   "store": "approvals",
   "view": "ferramentas",
   "row": {
    "g": "?",
    "text": "${what}",
    "meta": "${from}",
    "tone": "warn"
   },
   "actions": [
    {
     "key": "a",
     "label": "aprovar",
     "op": {
      "op": "remove",
      "toast": "aprovado: ${what}"
     }
    },
    {
     "key": "n",
     "label": "negar",
     "op": {
      "op": "remove",
      "toast": "negado: ${what}"
     }
    }
   ]
  },
  "roots": {
   "store": "roots",
   "view": "acesso",
   "row": {
    "g": "${warn?!:·}",
    "text": "${path}",
    "meta": "${warn}",
    "tone": "${warn?warn:}"
   },
   "actions": [
    {
     "key": "x",
     "label": "revogar",
     "op": {
      "op": "remove",
      "toast": "acesso a ${path} revogado"
     }
    }
   ]
  },
  "envVars": {
   "store": "envVars",
   "view": "avançado",
   "row": {
    "g": "$",
    "text": "${k}",
    "meta": "${v}"
   },
   "actions": [
    {
     "key": "e",
     "label": "editar valor",
     "op": {
      "op": "edit",
      "field": "v",
      "label": "valor"
     }
    },
    {
     "key": "x",
     "label": "remover",
     "op": {
      "op": "remove",
      "toast": "${k} removida"
     }
    }
   ],
   "enter": {
    "op": "edit",
    "field": "v",
    "label": "valor"
   }
  },
  "profiles": {
   "store": "profiles",
   "view": "perfil",
   "row": {
    "g": "${active?●:○}",
    "text": "${name}",
    "meta": "${email} · ${plan}"
   },
   "enter": {
    "op": "seq",
    "ops": [
     {
      "op": "set",
      "path": "item.active",
      "value": true,
      "exclusive": true
     },
     {
      "op": "set",
      "path": "store.profile.name",
      "value": "${name}",
      "toast": "perfil ${name}"
     }
    ]
   },
   "actions": [
    {
     "key": "r",
     "label": "renomear",
     "op": {
      "op": "edit",
      "field": "name",
      "label": "nome do perfil"
     }
    },
    {
     "key": "x",
     "label": "excluir",
     "op": {
      "op": "remove",
      "confirm": "excluir o perfil ${name}?"
     }
    }
   ]
  },
  "versions": {
   "store": "versions",
   "view": "atualizações",
   "row": {
    "g": "${failed?!:·}",
    "text": "${v}",
    "meta": "${channel} · ${state}",
    "tone": "${failed?warn:}"
   },
   "actions": [
    {
     "key": "i",
     "label": "baixar e instalar",
     "op": {
      "op": "async",
      "label": "baixando ${v}",
      "then": {
       "op": "set",
       "path": "item.state",
       "value": "pronta · /restart",
       "toast": "${v} pronta"
      }
     }
    },
    {
     "key": "t",
     "label": "retomar download",
     "when": "failed",
     "op": {
      "op": "async",
      "label": "retomando ${v} de 62%",
      "then": {
       "op": "seq",
       "ops": [
        {
         "op": "set",
         "path": "item.failed",
         "value": false
        },
        {
         "op": "set",
         "path": "item.state",
         "value": "pronta · /restart",
         "toast": "${v} pronta"
        }
       ]
      }
     }
    }
   ]
  }
 },
 "itemActions": {
  "key": [
   {
    "key": "r",
    "label": "restaurar padrão",
    "op": {
     "op": "fn",
     "name": "keyReset"
    }
   }
  ]
 },
 "forms": {
  "account": [
   {
    "field": "name",
    "label": "nome",
    "type": "text"
   },
   {
    "field": "provider",
    "label": "provider",
    "type": "choice",
    "values": [
     "anthropic",
     "openai",
     "claude-cli",
     "ollama",
     "gateway"
    ]
   },
   {
    "field": "model",
    "label": "modelo padrão",
    "type": "choice",
    "values": [
     "opus 4.6",
     "sonnet 4.6",
     "haiku 4.5",
     "gpt-5",
     "llama3.2"
    ]
   },
   {
    "field": "key",
    "label": "chave",
    "type": "text"
   },
   {
    "field": "limit",
    "label": "limite",
    "type": "text"
   }
  ],
  "integration": [
   {
    "field": "clientId",
    "label": "client id",
    "type": "text"
   },
   {
    "field": "guide",
    "label": "guia",
    "type": "display",
    "value": "console.cloud.google.com › APIs › Calendar › OAuth"
   }
  ]
 },
 "commands": [
  {
   "name": "new-account",
   "desc": "conta de provider",
   "op": {
    "op": "new",
    "list": "accounts",
    "item": {
     "name": "nova conta",
     "provider": "anthropic",
     "model": "sonnet 4.6",
     "status": "não validada",
     "active": false
    },
    "form": "account",
    "label": "conta",
    "back": "contas"
   }
  },
  {
   "name": "oauth-openai",
   "desc": "entrar na OpenAI pelo navegador",
   "op": {
    "op": "async",
    "label": "abrindo o login da OpenAI no navegador",
    "then": {
     "op": "toast",
     "text": "OpenAI conectada por OAuth"
    }
   }
  },
  {
   "name": "import-cli",
   "desc": "importar login do Claude CLI",
   "op": {
    "op": "push",
    "path": "store.accounts",
    "value": {
     "name": "Claude CLI",
     "provider": "claude-cli",
     "model": "opus 4.6",
     "status": "válida",
     "active": false
    },
    "toast": "login do Claude CLI importado"
   }
  },
  {
   "name": "ollama",
   "desc": "modelos locais",
   "op": {
    "op": "log",
    "cmd": "ollama",
    "out": [
     "llama3.2 · 2,0 GB",
     "qwen2.5-coder · 4,7 GB",
     "/ollama-pull nome · /ollama-remove nome"
    ]
   }
  },
  {
   "name": "ollama-pull",
   "desc": "baixar modelo",
   "op": {
    "op": "async",
    "label": "baixando ${$args}",
    "then": {
     "op": "toast",
     "text": "${$args} pronto"
    }
   }
  },
  {
   "name": "ollama-remove",
   "desc": "remover modelo",
   "op": {
    "op": "confirm",
    "text": "remover ${$args} do Ollama?",
    "then": {
     "op": "toast",
     "text": "${$args} removido"
    }
   }
  },
  {
   "name": "allow",
   "desc": "permitir padrão bash",
   "op": {
    "op": "push",
    "path": "store.bashPatterns",
    "value": {
     "pattern": "${$args}"
    },
    "toast": "padrão ${$args} permitido"
   }
  },
  {
   "name": "root",
   "desc": "dar acesso a uma pasta",
   "op": {
    "op": "push",
    "path": "store.roots",
    "value": {
     "path": "${$args}",
     "warn": ""
    },
    "toast": "acesso a ${$args}"
   }
  },
  {
   "name": "env",
   "desc": "CHAVE=valor",
   "op": {
    "op": "fn",
    "name": "envAdd"
   }
  },
  {
   "name": "diagnose",
   "desc": "diagnóstico",
   "op": {
    "op": "log",
    "cmd": "diagnóstico",
    "out": [
     "core ok · 16 plugins ativos",
     "anthropic ok · 182 ms",
     "sem erros nas últimas 24 h"
    ]
   }
  },
  {
   "name": "export",
   "desc": "exportar configurações",
   "op": {
    "op": "log",
    "cmd": "exportar",
    "out": [
     "cadente-config.json salvo em ~/Downloads"
    ]
   }
  },
  {
   "name": "import-config",
   "desc": "importar configurações",
   "op": {
    "op": "confirm",
    "text": "substituir as configurações por cadente-config.json?",
    "then": {
     "op": "toast",
     "text": "configurações importadas"
    }
   }
  },
  {
   "name": "new-profile",
   "desc": "novo perfil",
   "op": {
    "op": "push",
    "path": "store.profiles",
    "value": {
     "name": "${$args}",
     "email": "—",
     "plan": "grátis",
     "active": false
    },
    "toast": "perfil ${$args} criado"
   }
  },
  {
   "name": "login",
   "desc": "e-mail, Google ou GitHub",
   "op": {
    "op": "async",
    "label": "enviando link de acesso para ${$args}",
    "then": {
     "op": "toast",
     "text": "link enviado · confira o e-mail"
    }
   }
  },
  {
   "name": "logout",
   "desc": "sair desta conta",
   "op": {
    "op": "confirm",
    "text": "sair da conta deste perfil?",
    "then": {
     "op": "toast",
     "text": "sessão encerrada"
    }
   }
  },
  {
   "name": "setup",
   "desc": "refazer a configuração inicial",
   "op": {
    "op": "log",
    "cmd": "configuração inicial",
    "out": [
     "1 conta de IA · 2 perfil · 3 pastas com acesso · 4 atalhos",
     "↵ em cada passo · esc volta"
    ]
   }
  },
  {
   "name": "recover",
   "desc": "recuperar o Core",
   "op": {
    "op": "async",
    "label": "recuperando o Core",
    "then": {
     "op": "toast",
     "text": "Core ativo de novo"
    }
   }
  },
  {
   "name": "check-updates",
   "desc": "checar atualizações",
   "op": {
    "op": "async",
    "label": "checando atualizações",
    "then": {
     "op": "toast",
     "text": "2 versões disponíveis"
    }
   }
  },
  {
   "name": "restart",
   "desc": "reiniciar para atualizar",
   "op": {
    "op": "confirm",
    "text": "reiniciar o Cadente agora? as sessões ficam salvas",
    "then": {
     "op": "toast",
     "text": "reiniciando"
    }
   }
  }
 ],
