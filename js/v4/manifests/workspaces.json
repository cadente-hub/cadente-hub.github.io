{
 "plugin": "workspaces",
 "views": [
  {
   "id": "repositórios",
   "label": "repositórios",
   "list": "workspaces",
   "where": "!archived"
  },
  {
   "id": "alterações",
   "label": "alterações"
  },
  {
   "id": "arquivos",
   "label": "arquivos"
  },
  {
   "id": "arquivados",
   "label": "arquivados",
   "list": "workspaces",
   "where": "archived",
   "empty": "nada arquivado"
  },
  {
   "id": "sessões",
   "label": "sessões",
   "list": "wsSessions"
  }
 ],
 "lists": {
  "workspaces": {
   "store": "workspaces",
   "view": "repositórios",
   "row": {
    "g": "${archived?○:●}",
    "text": "${name}",
    "meta": "${branch} · ${path}"
   },
   "enter": {
    "op": "fn",
    "name": "selectWs"
   },
   "actions": [
    {
     "key": "c",
     "label": "copiar contexto",
     "op": {
      "op": "toast",
      "text": "copiado: ${path} · ${branch}"
     }
    },
    {
     "key": "b",
     "label": "nova branch",
     "op": {
      "op": "edit",
      "field": "branch",
      "label": "nova branch"
     }
    },
    {
     "key": "a",
     "label": "arquivar",
     "op": {
      "op": "set",
      "path": "item.archived",
      "value": true,
      "toast": "${name} arquivado"
     }
    },
    {
     "key": "u",
     "label": "restaurar",
     "op": {
      "op": "set",
      "path": "item.archived",
      "value": false,
      "toast": "${name} restaurado"
     },
     "view": "arquivados"
    },
    {
     "key": "x",
     "label": "excluir",
     "op": {
      "op": "remove",
      "confirm": "excluir ${name} e a worktree?"
     }
    },
    {
     "key": "o",
     "label": "abrir no editor",
     "op": {
      "op": "toast",
      "text": "abrindo ${path} no editor"
     }
    },
    {
     "key": "v",
     "label": "ver conteúdo arquivado",
     "op": {
      "op": "log",
      "cmd": "arquivado: ${name}",
      "out": [
       "notas: 2 · anexos: 1 · chat: 6 turnos · planos: 1"
      ]
     },
     "view": "arquivados"
    }
   ]
  },
  "changes": {
   "store": "changes",
   "view": "alterações",
   "row": {
    "text": "${path}"
   },
   "space": {
    "op": "cycle",
    "path": "item.state",
    "values": [
     "staged",
     "unstaged"
    ]
   },
   "enter": {
    "op": "set",
    "path": "data.diff",
    "value": "${id}"
   },
   "actions": [
    {
     "key": "m",
     "label": "comentar (problema, sugestão, pergunta)",
     "op": {
      "op": "edit",
      "field": "note",
      "label": "comentário local"
     }
    },
    {
     "key": "k",
     "label": "tipo: problema · sugestão · pergunta",
     "op": {
      "op": "cycle",
      "path": "item.kind",
      "values": [
       "problema",
       "sugestão",
       "pergunta"
      ]
     }
    },
    {
     "key": "d",
     "label": "ver diff",
     "op": {
      "op": "set",
      "path": "data.diff",
      "value": "${id}"
     }
    }
   ]
  },
  "files": {
   "store": "files",
   "view": "arquivos",
   "row": {
    "text": "${path}"
   },
   "enter": {
    "op": "fn",
    "name": "preview"
   },
   "actions": [
    {
     "key": "d",
     "label": "diff do arquivo",
     "op": {
      "op": "seq",
      "ops": [
       {
        "op": "view",
        "view": "alterações"
       },
       {
        "op": "set",
        "path": "data.diff",
        "value": "ch1"
       }
      ]
     }
    },
    {
     "key": "r",
     "label": "copiar referência",
     "op": {
      "op": "fn",
      "name": "refLine"
     }
    },
    {
     "key": "p",
     "label": "abrir em outra folha",
     "op": {
      "op": "fn",
      "name": "otherPane"
     }
    }
   ]
  },
  "wsSessions": {
   "store": "wsSessions",
   "row": {
    "text": "${name}",
    "meta": "${when}"
   },
   "enter": {
    "op": "goto",
    "plugin": "chat",
    "beside": true
   }
  }
 },
 "commands": [
  {
   "name": "new",
   "desc": "novo workspace (worktree + branch)",
   "op": {
    "op": "push",
    "path": "store.workspaces",
    "value": {
     "name": "${$args}",
     "branch": "feature/${$args}",
     "path": "~/dev/cadente/.worktrees/${$args}",
     "archived": false
    },
    "toast": "workspace ${$args} criado"
   }
  },
  {
   "name": "commit",
   "desc": "commitar o stage",
   "op": {
    "op": "fn",
    "name": "commit"
   }
  },
  {
   "name": "push",
   "desc": "enviar ao remoto",
   "op": {
    "op": "async",
    "label": "enviando",
    "then": {
     "op": "toast",
     "text": "enviado para origin"
    }
   }
  },
  {
   "name": "pr",
   "desc": "criar PR",
   "op": {
    "op": "fn",
    "name": "openPrFromWs"
   }
  },
  {
   "name": "sync-pr",
   "desc": "sincronizar PR",
   "op": {
    "op": "async",
    "label": "sincronizando PR",
    "then": {
     "op": "toast",
     "text": "PR sincronizado"
    }
   }
  },
  {
   "name": "fix-ci",
   "desc": "Chat ao lado com a falha de CI",
   "op": {
    "op": "goto",
    "plugin": "chat",
    "beside": true,
    "input": "Corrija a falha de CI em slint build"
   }
  },
  {
   "name": "split",
   "desc": "diff unificado ou split",
   "op": {
    "op": "seq",
    "ops": [
     {
      "op": "view",
      "view": "alterações"
     },
     {
      "op": "toggle",
      "path": "data.split"
     }
    ]
   }
  },
  {
   "name": "export",
   "desc": "md · word",
   "op": {
    "op": "log",
    "cmd": "exportar ${$args}",
    "out": [
     "revisão-local.${$args} salvo em ~/Downloads"
    ]
   }
  }
 ],
