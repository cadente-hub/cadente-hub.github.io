{
 "plugin": "inicio",
 "views": [
  {
   "id": "hoje",
   "label": "hoje"
  },
  {
   "id": "recentes",
   "label": "recentes"
  },
  {
   "id": "tarefas",
   "label": "tarefas",
   "list": "tasks",
   "sub": [
    {
     "label": "ativas",
     "where": "!done"
    },
    {
     "label": "concluídas",
     "where": "done"
    }
   ]
  },
  {
   "id": "notas",
   "label": "notas",
   "list": "notes",
   "sub": [
    {
     "label": "ativas",
     "where": "!done"
    },
    {
     "label": "concluídas",
     "where": "done"
    }
   ]
  },
  {
   "id": "atividade",
   "label": "atividade",
   "list": "activity"
  },
  {
   "id": "clima",
   "label": "clima"
  },
  {
   "id": "ações",
   "label": "ações",
   "list": "quick"
  }
 ],
 "lists": {
  "notes": {
   "store": "notes",
   "view": "notas",
   "row": {
    "g": "${pinned?◆:·}",
    "text": "${text}",
    "meta": "${when}"
   },
   "sort": "fixadas",
   "sorts": {
    "fixadas": "!pinned"
   },
   "actions": [
    {
     "key": "p",
     "label": "fixar ou desafixar",
     "op": {
      "op": "toggle",
      "path": "item.pinned",
      "toast": "nota ${pinned?fixada:desafixada}"
     }
    },
    {
     "key": "c",
     "label": "concluir ou reabrir",
     "op": {
      "op": "toggle",
      "path": "item.done",
      "toast": "nota ${done?concluída:reaberta}"
     }
    },
    {
     "key": "e",
     "label": "editar",
     "op": {
      "op": "edit",
      "field": "text",
      "label": "nota"
     }
    },
    {
     "key": "x",
     "label": "excluir",
     "op": {
      "op": "remove",
      "toast": "nota excluída"
     }
    }
   ],
   "enter": {
    "op": "edit",
    "field": "text",
    "label": "nota"
   }
  },
  "activity": {
   "store": "activity",
   "view": "atividade",
   "row": {
    "g": "·",
    "text": "${what}",
    "meta": "${when}"
   },
   "enter": {
    "op": "goto",
    "plugin": "${plugin}"
   }
  },
  "quick": {
   "store": "quick",
   "view": "ações",
   "row": {
    "g": "${g}",
    "text": "${label}",
    "meta": "${hint}"
   },
   "enter": {
    "op": "goto",
    "plugin": "${plugin}",
    "input": "${input}"
   }
  }
 },
 "commands": [
  {
   "name": "new-note",
   "desc": "nova nota",
   "op": {
    "op": "push",
    "path": "store.notes",
    "value": {
     "text": "${$args}",
     "pinned": false,
     "done": false,
     "when": "agora"
    },
    "toast": "nota criada"
   }
  },
  {
   "name": "city",
   "desc": "cidade do clima",
   "op": {
    "op": "set",
    "path": "store.weather.city",
    "value": "${$args}",
    "toast": "clima de ${$args}"
   }
  }
 ],
