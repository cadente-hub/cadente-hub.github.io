    ],
    "next": "seg 08:00",
    "on": true,
    "prompt": "Resuma o uso da semana",
    "dir": "~",
    "model": "sonnet 4.6",
    "system": "",
    "destructive": []
   },
   {
    "id": "a4",
    "name": "limpar-sessões",
    "times": [
     "dom 23:00"
    ],
    "next": "pausada",
    "on": false,
    "prompt": "Arquive sessões antigas",
    "dir": "~",
    "model": "haiku 4.5",
    "system": "",
    "destructive": [
     "arquivar"
    ]
   }
  ],
  "runs": [
   {
    "id": "r1",
    "automation": "revisão-noturna",
    "when": "há 9 h",
    "ok": true,
    "dur": "1 min 12 s",
    "transcript": [
     "leu 3 PRs abertos",
     "1 comentário sugerido em #248"
    ],
    "diff": [
     "+ comentário em pane.rs:44"
    ]
   },
   {
    "id": "r2",
    "automation": "sync-worktrees",
    "when": "há 12 min",
    "ok": true,
    "dur": "6 s",
    "transcript": [
     "cadente: 1 à frente",
     "warp: 3 atrás"
    ],
    "diff": []
   },
   {
    "id": "r3",
    "automation": "relatório-uso",
    "when": "há 4 d",
    "ok": false,
    "dur": "2 s",
    "error": "limite de taxa do provider"
   },
   {
    "id": "r4",
    "automation": "relatório-uso",
    "when": "há 11 d",
    "ok": false,
    "dur": "2 s",
    "error": "limite de taxa do provider"
   }
  ]
 }
}
